    {
      "id": "1f9ce10a-d2a9-4947-952b-1eb079514617",
      "name": "Signature valid and reply or bounce?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $('InvokeIQ webhook').item.json.headers['x-invokeiq-signature'] }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ 'sha256=' + $json.data }}"
            },
            {
              "leftValue": "={{ ['contact.replied'].includes($('InvokeIQ webhook').item.json.body.event) || String($('InvokeIQ webhook').item.json.body.event).includes('bounce') }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "e4e3a591-727c-401c-b2a6-2b5655f83213",
      "name": "Find person in Attio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.attio.com/v2/objects/people/records/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filter: { email_addresses: $('InvokeIQ webhook').item.json.body.data.contact.email }, limit: 1 }) }}"
      }
    },
    {
      "id": "e8f06160-d432-424e-8740-46c7a2fdf812",
      "name": "Add inbound Outreach entry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.attio.com/v2/lists/sales_partner_outreach/entries",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const b = $('InvokeIQ webhook').item.json.body; const d = b.data || {}; const company = $json.data[0].values.company[0].target_record_id; const bounced = String(b.event).includes('bounce'); return JSON.stringify({ data: { parent_record_id: company, parent_object: 'companies', entry_values: { lead: [{ target_object: 'companies', target_record_id: company }], channel: 'email', direction: 'inbound', status: 'sent', date: (d.receivedAt || b.timestamp || new Date().toISOString()).slice(0, 10), summary: bounced ? 'bounced' : ((d.category || 'reply') + ': ' + (d.threadSummary || '')), draft_body: bounced ? ('Bounced: ' + (d.contact && d.contact.email)) : ['Sentiment: ' + d.sentiment + ' (' + d.sentimentScore + ')', 'Subject: ' + d.subject, d.snippet, 'Received: ' + d.receivedAt].join('\\n') } } }); })() }}"
      }
    }
  ],
